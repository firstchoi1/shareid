# AppleAuto 托管（展示站独立部署：建议单独 Key，与主商城发货密钥分离）
SHOWCASE_APPLE_AUTO_BASE_URL="https://your-host.example.com"
SHOWCASE_APPLE_AUTO_API_KEY="replace-with-api-key"

# 未设置 SHOWCASE_* 时可回退（兼容）
# APPLE_AUTO_BASE_URL=""
# APPLE_AUTO_API_KEY=""

# 各地区标签 ID（数字，与托管站标签一致）
SHOWCASE_TAG_US="1"
SHOWCASE_TAG_US_ROCKET="6"
SHOWCASE_TAG_HK="2"
SHOWCASE_TAG_JP="3"
SHOWCASE_TAG_TW="4"
SHOWCASE_TAG_CN="5"

# 列表接口会返回明文密码供前端复制（与定时刷新同源）；勿在页面展示密码文本

# 教程视频：默认用哔哩哔哩嵌入（国内更快）。填写 BV 号；设为空字符串则改用下方 MP4
NEXT_PUBLIC_TUTORIAL_BILIBILI_BVID="BV1XFQwBQEWZ"
# NEXT_PUBLIC_TUTORIAL_BILIBILI_BVID=""
#
# 未使用 B 站嵌入时：教程视频 CDN 全路径或本地 /tutorial.mp4
# NEXT_PUBLIC_TUTORIAL_VIDEO_URL="https://cdn.example.com/shareid/tutorial.mp4"
# 可选：同内容 WebM（通常比 mp4 更小，需 ffmpeg 另导出）
# NEXT_PUBLIC_TUTORIAL_VIDEO_WEBM_URL="https://cdn.example.com/shareid/tutorial.webm"
# 可选：视频首帧封面 JPG/WebP，弹窗打开即有图，体感更快
# NEXT_PUBLIC_TUTORIAL_POSTER_URL="https://cdn.example.com/shareid/tutorial-poster.jpg"
