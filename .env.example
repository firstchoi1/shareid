# AppleAuto 托管（展示站独立部署：建议单独 Key，与主商城发货密钥分离）
SHOWCASE_APPLE_AUTO_BASE_URL="https://your-host.example.com"
SHOWCASE_APPLE_AUTO_API_KEY="replace-with-api-key"

# 未设置 SHOWCASE_* 时可回退（兼容）
# APPLE_AUTO_BASE_URL=""
# APPLE_AUTO_API_KEY=""

# 各地区标签 ID（数字，与托管站标签一致）
SHOWCASE_TAG_US="1"
SHOWCASE_TAG_HK="2"
SHOWCASE_TAG_JP="3"
SHOWCASE_TAG_TW="4"
SHOWCASE_TAG_CN="5"

# 列表接口会返回明文密码供前端复制（与定时刷新同源）；勿在页面展示密码文本

# 可选：教程视频用 CDN 全路径（OSS/R2/又拍等），减轻源站带宽、就近加速
# NEXT_PUBLIC_TUTORIAL_VIDEO_URL="https://cdn.example.com/shareid/tutorial.mp4"
